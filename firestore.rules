rules_version = '2';

// Reglas de Firestore para Joyas Pikete.
// Copiar en Firebase Console > Firestore Database > Reglas, y Publicar.
// Solo se aceptan lecturas y escrituras desde la app (con su sesion anonima de Firebase),
// y solo en las colecciones que usa: "config" y "ventas".
service cloud.firestore {
  match /databases/{database}/documents {
    match /config/{clave} {
      allow read, write: if request.auth != null;
    }
    match /ventas/{ventaId} {
      allow read, write: if request.auth != null;
    }
  }
}
